#!/bin/sh
# Refuse commits that stage - or leave tracked - private or generated files.
# Enable once per clone:  git config core.hooksPath .githooks
#
# .gitignore already covers these. This catches the two cases it cannot: a
# deliberate `git add -f`, and a file that was already tracked before the
# ignore rule existed (an ignore rule does nothing to an already-tracked path).

PATTERN='(^|/)config_local\.py$|\.local\.[^/]*$|^data/|^outputs/|\.env$|\.(csv|parquet|feather|xlsx|xls|h5|pkl|pdf)$|(^|/)statements/|(^|/)CLAUDE\.md$|(^|/)AGENTS\.md$|(^|/)\.claude|(^|/)\.cursor/|(^|/)\.aider'

blocked=$(printf '%s\n%s\n' "$(git diff --cached --name-only --diff-filter=ACMR)" "$(git ls-files)" \
  | grep -E "$PATTERN" | sort -u)

if [ -n "$blocked" ]; then
  echo "pre-commit: private or generated files in the commit or the index:" >&2
  printf '  %s\n' $blocked >&2
  echo "" >&2
  echo "These must not reach a public remote. Untrack with:  git rm --cached <path>" >&2
  exit 1
fi
